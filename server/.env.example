# API port
PORT=4000
# SQLite database file (default: server/data/jewellery.db)
DB_FILE=./data/jewellery.db
# Business details printed on invoices and used for GST place-of-supply
COMPANY_NAME=Jewellery ERP Demo Store
COMPANY_GSTIN=24ABCDE1234F1Z5
# GST state code of the business (24 = Gujarat)
COMPANY_STATE_CODE=24
